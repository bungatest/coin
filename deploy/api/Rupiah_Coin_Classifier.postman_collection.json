{
  "info": {
    "_postman_id": "c8e23971-4820-4a8b-821f-829285093df0",
    "name": "Rupiah Coin Classifier API",
    "description": "Koleksi Postman untuk pengujian API Klasifikasi Koin Rupiah (MobileNetV2).\nEndpoint mendukung Flask API (Port 5000) dan FastAPI (Port 8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Mengecek status server, framework aktif, dan ketersediaan model."
      },
      "response": []
    },
    {
      "name": "2. Metadata Kelas Koin",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/metadata",
          "host": ["{{base_url}}"],
          "path": ["metadata"]
        },
        "description": "Mendapatkan daftar 4 kelas koin, nominal angka, teks suara TTS, dan warna badge."
      },
      "response": []
    },
    {
      "name": "3. Predict Koin (Form-Data / Upload Gambar)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "description": "Pilih file foto koin (JPG/PNG)",
              "type": "file",
              "src": []
            },
            {
              "key": "crop_center_ratio",
              "value": "0.75",
              "description": "Rasio crop area tengah koin (default: 0.75)",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": ["{{base_url}}"],
          "path": ["predict"]
        },
        "description": "Endpoint utama pengujian Dosen via Postman. Kirim gambar koin pada key 'file'."
      },
      "response": []
    },
    {
      "name": "4. Predict Koin (Base64 JSON)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image\": \"data:image/jpeg;base64,...\",\n  \"crop_center_ratio\": 0.75\n}"
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": ["{{base_url}}"],
          "path": ["predict"]
        },
        "description": "Pengujian alternatif jika payload berupa string base64 dari canvas webcam."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    }
  ]
}
